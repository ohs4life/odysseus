# ohs-ai-build / parity env additions
# ====================================
# This file is the source of truth for env keys the new Manus-parity
# services need. Apply it with: scripts/apply-env.sh
#
# DO NOT put real secrets in this file. The placeholders below are
# for reference; replace them with real values AFTER applying.

# --- Common ---
PARITY_BUILD_VERSION=0.1
PARITY_LOG_DIR=/Users/ai/ohs-ai-build/logs
PARITY_VENV=/Users/ai/ohs-ai-build/.venv-tools
PARITY_REPO=/Users/ai/ohs-ai-build

# --- Phase A: code-exec sandbox MCP (port 8500) ---
CODE_EXEC_HOST=127.0.0.1
CODE_EXEC_PORT=8500
CODE_EXEC_MEM_MB=512
CODE_EXEC_TIMEOUT_S=30
CODE_EXEC_NETWORK=none
CODE_EXEC_ALLOWED_DOMAINS=

# --- Phase B: browser MCP (port 8766) ---
BROWSER_HOST=127.0.0.1
BROWSER_PORT=8766
BROWSER_PROFILE_DIR=/Users/ai/ohs-ai-build/mcp/browser/profile
BROWSER_DOWNLOAD_MAX_MB=50
BROWSER_DEFAULT_MODE=cloud         # cloud | operator

# --- Phase C: scheduler (port 8770) ---
SCHED_HOST=127.0.0.1
SCHED_PORT=8770
SCHED_FILE=/Users/ai/ohs-ai-build/scripts/schedules.yaml
SCHED_DEFAULT_USER=admin@optimalhealthsystems.com
SCHED_DEFAULT_AGENT=agent_sO0yCPLN39aQqs9HgVEQE

# --- Phase F: email ingest (port 8768) ---
EMAIL_HOST=127.0.0.1
EMAIL_PORT=8768
EMAIL_POLL_SECONDS=15
EMAIL_ALLOWLIST=/Users/ai/ohs-ai-build/scripts/email-allowlist.csv
EMAIL_DEFAULT_AGENT=agent_sO0yCPLN39aQqs9HgVEQE
EMAIL_SMTP_RELAY_HOST=127.0.0.1
EMAIL_SMTP_RELAY_PORT=2525

# --- Phase G: slack bot (port 8767) ---
SLACK_HOST=127.0.0.1
SLACK_PORT=8767
SLACK_SIGNING_SECRET=__paste_from_slack_app_dashboard__
SLACK_BOT_TOKEN=__paste_xoxb_token__
SLACK_USER_MAP=/Users/ai/ohs-ai-build/scripts/slack-user-map.json

# --- Phase H: API wrapper (port 8771) ---
API_WRAPPER_HOST=127.0.0.1
API_WRAPPER_PORT=8771
API_WRAPPER_SHARED_SECRET=__generate_with_openssl_rand_hex_32__

# --- Phase K: ollama (only when enabled) ---
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Phase L: zapier (uses API_WRAPPER_SHARED_SECRET) ---
ZAPIER_SHARED_SECRET=__generate_with_openssl_rand_hex_32__
